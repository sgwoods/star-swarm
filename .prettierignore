# Per-session harness settings, git-excluded and machine-generated. Prettier
# does not read git excludes, so without this `npm run lint` fails locally on a
# file that never reaches CI.
.claude/settings.local.json

# Golden replays are generated by scripts/record-replay.ts and compared byte for
# byte; reformatting them would make every regeneration look like a change.
tests/sim/golden/

# Scratch space for whoever is working here: git-excluded probes, one-off
# harnesses and video frames. Neither Prettier nor ESLint reads git excludes, so
# both need telling, or `npm run lint` fails locally on files that never reach CI.
.scratch/

# A log `npm run record` wrote, kept beside the clip `npm run capture` renders
# from it. Byte for byte what the command wrote, for the goldens' reason.
docs/media/*.replay.json

# A shelf entry is a player's export as the game wrote it (`src/ui/exchange.ts`),
# pasted into a pull request by somebody who has never run Prettier. Formatting it
# would fail the very submission `CONTRIBUTING.md` walks them through.
shelf/*.json
